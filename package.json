{
  "name": "@commerce/plugin-credentials",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "commerce": {
    "manifestVersion": 1,
    "id": "official.credentials",
    "title": "凭证管理",
    "description": "统一保存各工具的 AppID 与密钥，按需授权给其他工具使用",
    "category": "效率工具",
    "api": "^1.7.0",
    "ui": "ui/index.html",
    "releaseNotes": "首个版本：集中保存 AppID 与密钥，支持多条凭证、生产/沙箱环境、工具授权与撤销。",
    "permissions": {
      "credentialVault": "manage"
    },
    "icon": "data:image/png;base64,"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "pack": "node scripts/pack-plugin.mjs",
    "test:host": "node tests/host.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "dependencies": {
    "@commerce/plugin-sdk": "file:vendor/commerce-plugin-sdk-1.7.0.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0"
  },
  "license": "MIT"
}
